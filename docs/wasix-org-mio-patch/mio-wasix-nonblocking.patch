+/// `sock_open` makes a blocking socket. Left that way, a read with no data
+/// blocks the runtime's thread until Wasmer's socket timeout (30 s), then
+/// fails with ETIMEDOUT, and no timer or other task runs meanwhile.
+fn set_nonblocking(fd: u32) -> io::Result<()> {
+    unsafe {
+        let stat = wasi::fd_fdstat_get(fd).map_err(|errno| io::Error::from_raw_os_error(errno.raw() as i32))?;
+        wasi::fd_fdstat_set_flags(fd, stat.fs_flags | wasi::FDFLAGS_NONBLOCK)
+            .map_err(|errno| io::Error::from_raw_os_error(errno.raw() as i32))
+    }
+}
